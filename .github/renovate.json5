{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  assignees: [
    'nzbr',
  ],
  reviewers: [
    'nzbr',
  ],
  automergeStrategy: 'squash',
  automerge: true,
  platformAutomerge: false,
  minimumReleaseAge: '14 days',
  minimumReleaseAgeBuffer: null,
  internalChecksFilter: 'none',
  prCreation: 'immediate',
  labels: [
    'renovate',
  ],
  nix: {
    enabled: true,
  },
  npm: {
    rangeStrategy: 'pin',
  },
  lockFileMaintenance: {
    enabled: true,
    extends: [
      'schedule:weekly',
    ],
    automerge: true,
    minimumReleaseAge: null,
  },
  vulnerabilityAlerts: {
    automerge: false,
  },
  packageRules: [
    {
      matchManagers: ['custom.regex'],
      matchDatasources: ['docker'],
      versioning: 'regex:^(?<compatibility>.+)-(?<major>\\d+)\\.(?<minor>\\d+)$',
      automerge: true,
      minimumReleaseAge: null,
      platformAutomerge: true,
      pinDigests: true,
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['pin'],
      minimumReleaseAge: null,
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*\\.[jt]s$/',
      ],
      matchStrings: [
        'from\\s*=\\s*["\'](?<depName>[^:]+):(?<currentValue>[^@"\']+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?["\']',
      ],
      datasourceTemplate: 'docker',
      autoReplaceStringTemplate: 'from = "{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*$/',
      ],
      matchStrings: [
        'https://github.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/\\s"]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*\\.[jt]s$/',
      ],
      matchStrings: [
        'fetchGit\\s*\\(\\s*"https://github\\.com/(?<depName>[^"]+?)(?:\\.git)?"\\s*,\\s*"(?<currentValue>[^"]+)',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*\\.[jt]s$/',
      ],
      matchStrings: [
        'fetchGit\\s*\\(\\s*"https://gitlab\\.com/(?<depName>[^"]+?)(?:\\.git)?"\\s*,\\s*"(?<currentValue>[^"]+)',
      ],
      datasourceTemplate: 'gitlab-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*\\.[jt]s$/',
      ],
      matchStrings: [
        'fetchGit\\s*\\(\\s*"https://gitlab\\.freedesktop\\.org/(?<depName>[^"]+?)(?:\\.git)?"\\s*,\\s*"(?<currentValue>[^"]+)',
      ],
      datasourceTemplate: 'gitlab-tags',
      registryUrlTemplate: 'https://gitlab.freedesktop.org',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.*.nix$/',
      ],
      matchStrings: [
        '"github:(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/"]+)"',
      ],
      datasourceTemplate: 'github-tags',
    },
  ],
}
